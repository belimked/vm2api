# copy to /etc/vm2api.env  (chmod 600)
# VM2API_* wins; KIN_* is fallback.
#
# 未配置时一键脚本 / 容器入口只填空字段：管理台 admin / 123456。

VM2API_API_KEY=
VM2API_ADMIN_USER=admin
VM2API_ADMIN_PASSWORD=123456
VM2API_DB_SECRET=

PORT=8787
HOST=0.0.0.0
# PUBLIC_BASE_URL=https://example.com
# GITHUB_TOKEN=          # 可选。面板查 GitHub Release 提高限额；也可用 VM2API_GITHUB_TOKEN

KIN_PROJECT_ROOT=/opt/vm2api
KIN_DATA_DIR=/opt/vm2api/data
KIN_KERNEL_BIN=/opt/vm2api/bin/kin-kernel
KIN_EGRESS_BIN=/opt/vm2api/bin/kin-egress
KIN_WORKER_BIN=/opt/vm2api/bin/kin-worker
